# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- privacy ---------------------------------------------------------------------------------------------
# Random secret (>= 32 bytes) for pseudonymous user ids. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it orphans existing records (they then age out under the 90-day retention).
KUDIGUARD_HASH_SECRET=
# Where the server stores data, as told to users: outside-nigeria (default, the pilot PC) | nigeria.
KUDIGUARD_STORAGE_LOCATION=outside-nigeria
# Opt-in voice-note donation (docs/DPIA_VOICE.md). Keep false until the DPIA is signed off.
KUDIGUARD_VOICE_DONATION=false
# Encryption key for donated audio (>= 32 bytes); empty = derived from KUDIGUARD_HASH_SECRET. To rotate either:
# run `kudiguard voice wipe --all` first (old audio becomes unreadable), then change the key and restart.
KUDIGUARD_VOICE_KEY=
# Retention (at most 365: the offer promises 12 months) and caps.
KUDIGUARD_VOICE_RETENTION_DAYS=365
KUDIGUARD_VOICE_MAX_PER_DAY=20
KUDIGUARD_VOICE_MAX_GB=5
# KUDIGUARD_VOICE_DIR=var/voice   (default; a .vault marker ties it to the database above)

# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ----------------------------
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging (+ whatsapp_business_management) permissions.
WHATSAPP_ACCESS_TOKEN=
# App Dashboard > Settings > Basic > App secret (verifies X-Hub-Signature-256 on every webhook).
WHATSAPP_APP_SECRET=
# Any random string you choose; enter the same value when configuring the webhook URL in Meta.
WHATSAPP_VERIFY_TOKEN=
# Graph API version (default v25.0).
WHATSAPP_API_VERSION=v25.0
# Comma-separated tester numbers for the live smoke test (personal data: keep only in .env).
WHATSAPP_TEST_RECIPIENTS=

# --- models ----------------------------------------------------------------------------------------------
# Hugging Face read token (classic "Read" type) for the one-time NCAIR1 speech model conversion.
HF_TOKEN=
HF_HOME=
# N-ATLAS llama-server (scripts/run_llm.ps1).
KUDIGUARD_LLM_URL=http://127.0.0.1:8081
# Grounding check of English replies (needs KUDIGUARD_EMBEDDINGS; fails open; docs/SPIKES.md S8).
# off | shadow (record only, default) | enforce (drop unsupported steps or send fixed text). Use enforce only after
# >= 100 held-out real N-ATLAS English replies show <= 5% false replacements.
KUDIGUARD_GROUNDING_MODE=shadow
KUDIGUARD_GROUNDING_THRESHOLD=0.75
KUDIGUARD_GROUNDING_BUDGET_MS=150
# Learned second guard layer for English replies (data/guard/en_classifier.npz; needs KUDIGUARD_EMBEDDINGS).
# off | shadow (score after sending, log only; default for the pilot) | enforce (flagged -> retry -> fixed text).
# Pidgin replies can run in their own mode (e.g. English enforce, Pidgin shadow); unset = the same mode.
# Threshold: unset = the artefact's shipped point 0.85 (out-of-fold ~84% recall / 3.7% false positives); 0.945 =
# the strict point (~74% / 1.8%). Past the budget the regex verdict stands (fail open).
KUDIGUARD_GUARD_CLASSIFIER_MODE=shadow
# KUDIGUARD_GUARD_CLASSIFIER_PIDGIN_MODE=shadow
# KUDIGUARD_GUARD_CLASSIFIER_THRESHOLD=0.945
KUDIGUARD_GUARD_CLASSIFIER_BUDGET_MS=250
# How ha/yo/ig replies are written: english_first (compose in English, run the English checks, translate, check the
# translation) or direct (compose in the language), default first then per-language overrides. English is always
# direct. Default: Yoruba/Igbo English-first, Hausa direct (docs/SPIKES.md H).
KUDIGUARD_COMPOSE_STRATEGY=english_first,ha=direct

# --- public pages (/privacy) ---------------------------------------------------------------
KUDIGUARD_OPERATOR_NAME=
KUDIGUARD_PRIVACY_CONTACT=
