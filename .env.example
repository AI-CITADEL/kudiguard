# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- privacy ---------------------------------------------------------------------------------------------
# Random secret (>= 32 bytes) for pseudonymous user ids. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it orphans existing records (they then age out under the 90-day retention).
KUDIGUARD_HASH_SECRET=
# Where the server stores data, as told to users: outside-nigeria (default, the pilot PC) | nigeria.
KUDIGUARD_STORAGE_LOCATION=outside-nigeria
# Retention in days (shown to users): 31-90 and 30-730. The consent text promises "up to"; longer is refused, and
# messages are kept at least 31 days because the licence cap counts active users from them over 30 days.
KUDIGUARD_RETENTION_DAYS=90
KUDIGUARD_PATTERN_RETENTION_DAYS=730
# Partner knowledge packs in "mode: live" send the English text of each message to the partner: keep false
# (true also discloses it on /privacy). Prefer "mode: sync".
KUDIGUARD_ALLOW_LIVE_PACKS=false
# Opt-in voice-note donation (docs/DPIA_VOICE.md). Keep false until the DPIA is signed off.
KUDIGUARD_VOICE_DONATION=false
# Encryption key for donated audio (>= 32 bytes); empty = derived from KUDIGUARD_HASH_SECRET. To rotate either:
# run `kudiguard voice wipe --all` first (old audio becomes unreadable), then change the key and restart.
KUDIGUARD_VOICE_KEY=
# Retention (at most 365: the offer promises 12 months) and caps.
KUDIGUARD_VOICE_RETENTION_DAYS=365
KUDIGUARD_VOICE_MAX_PER_DAY=20
KUDIGUARD_VOICE_MAX_GB=5
# KUDIGUARD_VOICE_DIR=var/voice   (default; a .vault marker ties it to the database above)

# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ----------------------------
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging (+ whatsapp_business_management) permissions.
WHATSAPP_ACCESS_TOKEN=
# App Dashboard > Settings > Basic > App secret (verifies X-Hub-Signature-256 on every webhook).
WHATSAPP_APP_SECRET=
# Any random string you choose; enter the same value when configuring the webhook URL in Meta.
WHATSAPP_VERIFY_TOKEN=
# Graph API version, vNN.N (default v25.0; anything else is refused at startup).
WHATSAPP_API_VERSION=v25.0
# Comma-separated tester numbers for the live smoke test (personal data: keep only in .env).
WHATSAPP_TEST_RECIPIENTS=

# --- models ----------------------------------------------------------------------------------------------
# Hugging Face read token (classic "Read" type) for the one-time NCAIR1 speech model conversion.
HF_TOKEN=
# Hugging Face cache folder (unset = the library default).
# HF_HOME=
# N-ATLAS llama-server (scripts/run_llm.ps1).
KUDIGUARD_LLM_URL=http://127.0.0.1:8081
# Bearer token for the model server, if it needs one (blank = none).
# KUDIGUARD_LLM_API_KEY=
# Converted CTranslate2 speech models (scripts/prepare_asr.py) and the fastembed model cache.
# KUDIGUARD_MODEL_CACHE=models
# KUDIGUARD_EMBEDDINGS_CACHE=models/fastembed
# Voice: speech recognition on/off, the languages whose speech models are loaded at startup, and the ffmpeg binary
# (unset = found on PATH).
# KUDIGUARD_SPEECH=true
# KUDIGUARD_PRELOAD_LANGUAGES=ha,en
# KUDIGUARD_FFMPEG=
# The learned guard's artefact.
# KUDIGUARD_GUARD_CLASSIFIER_PATH=data/guard/en_classifier.npz
# Grounding check of English replies (needs KUDIGUARD_EMBEDDINGS; fails open; docs/SPIKES.md S8).
# off | shadow (record only, default) | enforce (drop unsupported steps or send fixed text). Use enforce only after
# >= 100 held-out real N-ATLAS English replies show <= 5% false replacements.
KUDIGUARD_GROUNDING_MODE=shadow
KUDIGUARD_GROUNDING_THRESHOLD=0.75
KUDIGUARD_GROUNDING_BUDGET_MS=150
# Learned second guard layer for English replies (data/guard/en_classifier.npz; needs KUDIGUARD_EMBEDDINGS).
# off | shadow (score after sending, log only; default for the pilot) | enforce (flagged -> retry -> fixed text).
# Pidgin replies can run in their own mode (e.g. English enforce, Pidgin shadow); unset = the same mode.
# Threshold: unset = the artefact's shipped point 0.85: verifier's held-out en+pcm set ~70% recall / 2.3% false
# positives; out of fold on our 1,135 training items 84% / 3.7%. 0.945 = the strict point (out of fold 74% / 1.8%).
# Past the budget the regex verdict stands (fail open).
KUDIGUARD_GUARD_CLASSIFIER_MODE=shadow
# KUDIGUARD_GUARD_CLASSIFIER_PIDGIN_MODE=shadow
# KUDIGUARD_GUARD_CLASSIFIER_THRESHOLD=0.945
KUDIGUARD_GUARD_CLASSIFIER_BUDGET_MS=250
# How ha/yo/ig replies are written: english_first (compose in English, run the English checks, translate, check the
# translation) or direct (compose in the language), default first then per-language overrides. English is always
# direct. Default: Yoruba/Igbo English-first, Hausa direct (docs/SPIKES.md H).
KUDIGUARD_COMPOSE_STRATEGY=english_first,ha=direct

# --- data, packs, channels and limits (defaults shown) -------------------------------------------------
# KUDIGUARD_DATA_DIR=data
# KUDIGUARD_DB_PATH=var/kudiguard.db
# Comma-separated pack ids (empty = every enabled pack); fictional demo packs only when allowed (never in production).
# KUDIGUARD_PACKS=
# KUDIGUARD_ALLOW_SAMPLE_PACKS=false
# KUDIGUARD_WHATSAPP_ENABLED=true
# Public base URL (the privacy link in the WhatsApp welcome), e.g. https://kudiguard.example.org
# KUDIGUARD_PUBLIC_URL=
# KUDIGUARD_DEFAULT_LANGUAGE=en
# Per-user WhatsApp messages per hour; seconds per turn.
# KUDIGUARD_PER_USER_PER_HOUR=20
# KUDIGUARD_TURN_DEADLINE_S=60
# N-ATLaS licence cap: active end-users per rolling 30 days on every channel, and the share open to web sessions.
# KUDIGUARD_ACTIVE_USER_CAP=1000
# KUDIGUARD_WEB_SESSION_CAP=200
# Requests per minute per API key / per client IP on the web page.
# KUDIGUARD_API_RATE_PER_MINUTE=30
# KUDIGUARD_WEB_RATE_PER_MINUTE=6
# Client IP from CF-Connecting-IP (else the rightmost X-Forwarded-For). ONLY behind Cloudflare: any other proxy passes a
# client-sent CF-Connecting-IP through, which makes the web rate limit spoofable. Keep false otherwise.
# KUDIGUARD_TRUST_PROXY_HEADERS=false

# --- partner REST API (/v1) -------------------------------------------------------------------------------
# OFF in the pilot: /v1 is not mounted. When true, every call needs X-API-Key and X-KudiGuard-End-User (a stable
# pseudonymous id per end user, never a phone number); each end user counts toward the N-ATLaS licence cap
# (1,000 active end-users per rolling 30 days, shared with WhatsApp and web). Partners beyond that need their own
# licence cover (docs/DEPLOY.md, "Partner API").
KUDIGUARD_PARTNER_API=false
# Comma-separated name:key pairs (keys >= 24 chars), used only when the partner API is on.
KUDIGUARD_API_KEYS=


# --- malicious use (docs/ABUSE.md) ---------------------------------------------------------
# Every defence: off | shadow (detect and log, reply unchanged) | enforce. Phrases live in data/languages/*.yaml
# under `abuse:` (ha/yo/ig DRAFT); replies and help numbers in `strings:` (crisis_reply, abuse_reply, ...).
# self-harm: humane fixed reply with 112 + SURPIN, sent first and before any gate; the scam check follows
KUDIGUARD_ABUSE_CRISIS_MODE=enforce
# second crisis layer: meaning similarity to crisis exemplars (needs embeddings); log only until measured
KUDIGUARD_CRISIS_SEMANTIC_MODE=shadow
KUDIGUARD_CRISIS_SEMANTIC_THRESHOLD=0.82
# insults/hate/sexual messages at the bot (not when rules find a red flag)
KUDIGUARD_ABUSE_HARASSMENT_MODE=enforce
# "write/translate a message that sounds like my bank": refusal
KUDIGUARD_ABUSE_SCAM_TOOL_MODE=enforce
# high-precision override/role/prompt-extraction phrases and chat-template tokens: rules-only answer
KUDIGUARD_ABUSE_INJECTION_MODE=enforce
# broad phrases genuine users also write ("confirm that this is genuine", "developer mode"): log only
KUDIGUARD_ABUSE_INJECTION_SUSPECT_MODE=shadow
# replies claiming to be a bank, leaking the prompt, or echoing input
KUDIGUARD_REPLY_SCREEN_MODE=enforce
KUDIGUARD_REPLY_ECHO_WORDS=12
# "thanks for watching", "[Music]": not a message
KUDIGUARD_ASR_HALLUCINATION_MODE=enforce
# partner packs/APIs: quarantine planted instructions and unsafe facts
KUDIGUARD_PACK_SCREEN_MODE=enforce
# our own reviewed core packs: log only
KUDIGUARD_PACK_SCREEN_CORE_MODE=shadow
# scam pattern library and voice donations
KUDIGUARD_LEARNING_GATE_MODE=enforce
KUDIGUARD_PATTERN_MAX_PER_USER_PER_DAY=5
KUDIGUARD_PATTERN_MAX_SIMILAR_PER_WEEK=20
# users new to the licence window: "busy, try again in an hour"
KUDIGUARD_NEW_USER_MODE=enforce
# empty = no cap
KUDIGUARD_NEW_USERS_PER_HOUR=100
KUDIGUARD_NEW_USERS_PER_DAY=300
# per-user queue cap, one rate-limit notice per interval, voice budget
KUDIGUARD_FLOOD_MODE=enforce
KUDIGUARD_MAX_QUEUED_PER_USER=10
KUDIGUARD_RATE_NOTICE_INTERVAL_S=600
KUDIGUARD_VOICE_NOTES_PER_USER_PER_HOUR=30
# --- public pages (/privacy) ---------------------------------------------------------------
KUDIGUARD_OPERATOR_NAME=
KUDIGUARD_PRIVACY_CONTACT=
